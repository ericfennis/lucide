# Copy to `docs/.env`. Every variable is optional.

# Icon popularity from Plausible. Defaults to 0 for every icon when unset.
LUCIDE_ANALYTICS_TOKEN=

# Client-side Algolia icon search (public search-only key).
# Overrides the defaults in docs/.vitepress/theme/utils/algolia.ts,
# e.g. to point the site at a staging index.
VITE_ALGOLIA_APP_ID=R7KKMCPXOB
VITE_ALGOLIA_SEARCH_API_KEY=dd3101054267d35fb28f49c42715f1aa
VITE_ALGOLIA_INDEX_NAME=icons

# Server-side only, used by docs/scripts/writeAlgoliaIndex.mts.
# The index is uploaded when VERCEL_ENV=production or ALGOLIA_FORCE_INDEX=1.
ALGOLIA_APP_ID=R7KKMCPXOB
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_INDEX_NAME=icons
ALGOLIA_FORCE_INDEX=
